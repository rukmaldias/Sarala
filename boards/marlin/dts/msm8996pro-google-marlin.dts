// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel XL (marlin) — Qualcomm MSM8996 Pro.
 *
 * STAGE 1 bring-up. Built up from the Pro sibling's substrate rather than a
 * bare skeleton: a minimal skeleton (SoC dtsi + just the console UART) faults
 * the mainline kernel very early (NOC_ERROR / TrustZone abort, before any
 * console) — it is missing the regulators/PMIC/pinctrl a real board carries.
 * The oneplus msm8996 common dtsi supplies exactly that and is proven to boot
 * msm8996 to a console, so we reuse it here.
 *
 * RESULT (verified on hardware 2026-07-27): the mainline kernel boots to
 * completion and runs `/init` — kernel log on ttyMSM0 over the 3.5mm jack
 * (blsp1_uart2, 0x7570000), ending in `Run /init as init process`. Got here by
 * iterating past every NOC abort from unpowered/oneplus-only peripherals: SMMUs,
 * BLSP2 block, GPU, SMP2P IPC to the DSPs, the oneplus board peripherals
 * (display/camera/audio/PCIe/USB/UFS/modem), the oneplus BLSP1 i2c buses, and
 * finally CPU DVFS (see the trims below). Boot cmdline needs `clk_ignore_unused`
 * (else clk_disable_unused WARNs on `fd_ahb_clk`, a CAMSS clock under a
 * powered-off domain). The kernel is no longer the blocker; the next frontier is
 * userspace (Sarala `/init` resets in ~40 ms — needs a console). See
 * first-boot.md.
 *
 * TEMPORARY: cribbing msm8996-oneplus-common.dtsi makes marlin masquerade as a
 * oneplus board (its regulators/panel/touch/sound). Stage-1 stepping stone to a
 * live console; a marlin-specific node set replaces it later.
 *
 * CONSOLE (corrected 2026-07-27 — the jack is BLSP2, not BLSP1; see first-boot.md):
 *  - The 3.5mm jack debug UART is blsp2_uart2 (0x75b0000). What is visible on the
 *    jack is the `earlycon` (msm_serial_dm0) bound via stdout-path = serial1
 *    (blsp2), inherited from oneplus-common; `keep_bootcon` keeps it alive so we
 *    see the whole boot. Proven by tracing port->mapbase (console writes go to
 *    0x75b0000; ttyMSM0 tty writes go to 0x7570000 and never reach the jack).
 *  - blsp2_uart2's FULL driver probe still NOC-aborts, so it stays disabled and
 *    we cannot yet expose it as a runtime tty. The earlycon only pokes TX, which
 *    works, so the block is reachable — fixing the probe is the open task.
 *  - blsp1_uart2 (0x7570000, ttyMSM0) is enabled as the runtime console/tty, but
 *    it is NOT the jack, so its output is invisible. TODO: once blsp2_uart2
 *    probes, move the runtime console + shell tty onto it (the real jack).
 *  Boot with cmdline: `earlycon console=ttyMSM0,115200n8 clk_ignore_unused`
 *  (stdout-path stays serial1, inherited from oneplus-common).
 */
/dts-v1/;

#include "msm8996pro.dtsi"
#include "msm8996-oneplus-common.dtsi"

/ {
	model = "Google Pixel XL";
	compatible = "google,marlin", "qcom,msm8996pro", "qcom,msm8996";
	chassis-type = "handset";

	/* aboot dtb-match IDs — confirmed from the aboot log (MSM8996 Pro v1.1). */
	qcom,msm-id = <422 0x10001>, <423 0x10001>;
	qcom,board-id = <0x80 0>;
};

/*
 * The whole BLSP2 block is dead/inaccessible on marlin — register access
 * NOC-aborts. Disable every BLSP2 peripheral, including the BAM DMA engine
 * (0x7584000): its `bam` driver READS BAM registers at probe (it is
 * qcom,controlled-remotely, so it does not power the block itself), and that
 * read into the gated BLSP2 block is the async PNOC RD+DISC abort that reset us
 * at execve — see the ERRLOG decode in first-boot.md. blsp1_dma (0x7544000, the
 * console block's BAM) is fine and stays enabled.
 */
&blsp2_uart2 { status = "disabled"; };
&blsp2_i2c1  { status = "disabled"; };
&blsp2_i2c6  { status = "disabled"; };
&blsp2_dma   { status = "disabled"; };

/*
 * blsp1_uart2 is marlin's DEBUG CONSOLE (the 3.5mm jack), not oneplus's
 * Bluetooth UART. oneplus-common attaches a qca6174 `bluetooth` serdev child,
 * which makes the serial core register the port as a *serdev controller*
 * (serial0) instead of a plain tty — so ttyMSM0 gets no /sys/class/tty entry,
 * no /dev node, and open() returns ENXIO: the kernel console (printk) works but
 * userspace (PID 1, the shell) has no usable serial tty. Drop the serdev child
 * (and the BT-only rtscts/label) so the port registers as a normal tty ttyMSM0.
 */
&blsp1_uart2 {
	/delete-property/ label;
	/delete-property/ uart-has-rtscts;

	/*
	 * Use PIO, not BAM DMA, for the console tty. msm_serial routes tty TX/RX
	 * through blsp1_dma (dmas = <&blsp1_dma 2 3>), but that DMA path produces
	 * no physical output on marlin (a tty write succeeds and tcdrain returns,
	 * yet nothing reaches the jack — while the console's polled writes do).
	 * Dropping the dmas makes ttyMSM0 transmit in PIO, matching the console.
	 * (delete-property must precede delete-node per dtc.)
	 */
	/delete-property/ dmas;
	/delete-property/ dma-names;

	/delete-node/ bluetooth;
};

/*
 * Multimedia (MMSS) and audio (LPASS) IOMMUs: register access NOC-aborts
 * because those power domains aren't up, and none are needed for a stage-1
 * serial boot. adreno_smmu (GPU) probes fine and is left enabled. VERIFIED:
 * disabling these gets the boot past all SMMUs (~2.94 s).
 */
&mdp_smmu      { status = "disabled"; };
&venus_smmu    { status = "disabled"; };
&vfe_smmu      { status = "disabled"; };
&lpass_q6_smmu { status = "disabled"; };

/*
 * GPU stack: adreno_smmu probes fine initially but NOC-aborts when re-probed
 * during deferred_probe (~13 s) as the GPU consumer pulls it in. Graphics is
 * unused for stage-1, so disable both.
 */
&gpu         { status = "disabled"; };
&adreno_smmu { status = "disabled"; };

/*
 * SMP2P IPC to the DSPs (ADSP/MPSS/SLPI). Those remotes are still running from
 * aboot and send SMP2P interrupts; our handler NOC-aborts (async — the crash
 * point moved with logging). We don't use the DSPs, so disable the channels.
 * (No top-level labels in the SoC dtsi, so reference by path.)
 */
&{/smp2p-adsp} { status = "disabled"; };
&{/smp2p-mpss} { status = "disabled"; };
&{/smp2p-slpi} { status = "disabled"; };

/*
 * STEP #2 — trim the oneplus board peripherals (2026-07-27).
 *
 * oneplus-common brings up its own panel, camera, audio card, WiFi/PCIe, USB,
 * UFS and modem, all wired to oneplus-specific GPIOs/regulators/remotes that
 * marlin does NOT share. None is needed for a stage-1 serial-console boot, and
 * none feeds the console path (blsp1_uart2 + its gcc clocks + the PM8994
 * rails), so disabling them is safe for the boot while shrinking the masquerade
 * toward a marlin-specific node set. This also clears candidate async-NOC
 * sources — especially mss_pil, which pokes the still-running MPSS modem the
 * same remote SMP2P already faulted us on.
 */
&mdp           { status = "disabled"; };  /* display controller */
&mdss          { status = "disabled"; };
&mdss_dsi0     { status = "disabled"; };
&mdss_dsi0_phy { status = "disabled"; };
&camss         { status = "disabled"; };  /* camera */
&sound         { status = "disabled"; };  /* audio card */
&q6asmdai      { status = "disabled"; };
&slim_msm      { status = "disabled"; };  /* SLIMbus (audio) */
&pcie0         { status = "disabled"; };  /* WiFi/PCIe */
&pcie_phy      { status = "disabled"; };
&usb3          { status = "disabled"; };  /* USB */
&hsusb_phy1    { status = "disabled"; };
&hsusb_phy2    { status = "disabled"; };
&ufshc         { status = "disabled"; };  /* UFS storage */
&ufsphy        { status = "disabled"; };
&mss_pil       { status = "disabled"; };  /* modem PIL — pokes MPSS remote */

/*
 * oneplus BLSP1 i2c buses carrying oneplus-only client devices marlin lacks:
 *   blsp1_i2c3 (0x7577000) → tfa9890 audio amp
 *   blsp1_i2c6 (0x757a000) → bq27541 fuel gauge
 * Probing the bus brings up the QUP to reach those absent devices, which throws
 * a PNOC (peripheral NOC) abort → instant TZ reset right after ttyMSM0 comes up
 * (~2.38 s). This was the "residual async NOC" — captured at last via aboot's
 * NOC error dump (PNOC ERRLOG1 = 0x0a801204, a BLSP QUP route). marlin's own
 * i2c bus/device map replaces these later. (blsp2_i2c1's fusb301 is already
 * covered by the blsp2 block-disable above.)
 */
&blsp1_i2c3    { status = "disabled"; };
&blsp1_i2c6    { status = "disabled"; };

/*
 * Stage-1: disable CPU DVFS. mainline qcom-cpufreq-nvmem does its first
 * clk_set_rate on the Kryo clock (&kryocc), which reprograms the APCS PLL/mux +
 * CBF and the vdd-apc CPR — that path NOC-aborts on marlin (instant TZ reset at
 * the first cpufreq setpoint ~2.0 s, right after ttyMSM0; aboot logs
 * NOC_ERROR). Dropping operating-points-v2 from the CPUs makes cpufreq fail to
 * build a table, so the cores simply stay at the boot frequency — fine for a
 * serial-console boot. Real DVFS (with CPR/vdd-apc modelled) is a later stage.
 */
&cpu0 { /delete-property/ operating-points-v2; };
&cpu1 { /delete-property/ operating-points-v2; };
&cpu2 { /delete-property/ operating-points-v2; };
&cpu3 { /delete-property/ operating-points-v2; };
