// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel XL (marlin) — Qualcomm MSM8996 Pro.
 *
 * STAGE 1 bring-up. Built up from the Pro sibling's substrate rather than a
 * bare skeleton: a minimal skeleton (SoC dtsi + just the console UART) faults
 * the mainline kernel very early (NOC_ERROR / TrustZone abort, before any
 * console) — it is missing the regulators/PMIC/pinctrl a real board carries.
 * The oneplus msm8996 common dtsi supplies exactly that and is proven to boot
 * msm8996 to a console, so we reuse it here.
 *
 * RESULT (verified on hardware 2026-07-26): the kernel boots and 400+ lines of
 * kernel log appear on ttyMSM0 over the 3.5mm jack (blsp1_uart2, 0x7570000) —
 * the stage-1 "kernel log over serial" signal, on real marlin.
 *
 * KNOWN ISSUE: with the oneplus config, blsp2_uart2 (0x75b0000, oneplus's
 * console — unused on marlin) is enabled and its probe NOC-aborts at ~2.7 s
 * once the console is up. Disabling it in isolation broke the console path in
 * testing, so it is left as the next thing to resolve. See first-boot.md.
 *
 * TEMPORARY: cribbing msm8996-oneplus-common.dtsi makes marlin masquerade as a
 * oneplus board (its regulators/panel/touch/sound). This is a stage-1 stepping
 * stone to a live console; a marlin-specific node set replaces it later.
 *
 * Console: bare `earlycon` on blsp1_uart2 faults early (see first-boot.md) — do
 * NOT use it. Use `console=ttyMSM0,115200n8` only; the driver brings the UART up
 * (with clocks) at ~2.7 s.
 */
/dts-v1/;

#include "msm8996pro.dtsi"
#include "msm8996-oneplus-common.dtsi"

/ {
	model = "Google Pixel XL";
	compatible = "google,marlin", "qcom,msm8996pro", "qcom,msm8996";
	chassis-type = "handset";

	/* aboot dtb-match IDs — confirmed from the aboot log (MSM8996 Pro v1.1). */
	qcom,msm-id = <422 0x10001>, <423 0x10001>;
	qcom,board-id = <0x80 0>;
};
