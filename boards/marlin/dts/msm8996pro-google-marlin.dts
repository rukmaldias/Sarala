// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel XL (marlin) — Qualcomm MSM8996 Pro.
 *
 * STAGE 1 bring-up. Built up from the Pro sibling's substrate rather than a
 * bare skeleton: a minimal skeleton (SoC dtsi + just the console UART) faults
 * the mainline kernel very early (NOC_ERROR / TrustZone abort, before any
 * console) — it is missing the regulators/PMIC/pinctrl a real board carries.
 * The oneplus msm8996 common dtsi supplies exactly that and is proven to boot
 * msm8996 to a console, so we reuse it here.
 *
 * RESULT (verified on hardware 2026-07-26): the kernel boots and kernel log
 * appears on ttyMSM0 over the 3.5mm jack (blsp1_uart2, 0x7570000) — the stage-1
 * "kernel log over serial" signal, on real marlin. Iterating past NOC aborts
 * from unpowered peripherals (SMMUs, BLSP2 block, GPU). With `initcall_debug`
 * the boot is seen running deep into deferred_probe (~13 s, console up). Next
 * crash is at an I2C *device* probe on BLSP1 (bq27541/`1-0055` area). Chasing
 * that (and likely more peripherals) is ongoing — see first-boot.md.
 *
 * TEMPORARY: cribbing msm8996-oneplus-common.dtsi makes marlin masquerade as a
 * oneplus board (its regulators/panel/touch/sound). Stage-1 stepping stone to a
 * live console; a marlin-specific node set replaces it later.
 *
 * CONSOLE (subtle — see first-boot.md):
 *  - blsp2_uart2 (0x75b0000, oneplus's console) is UNUSED on marlin; its driver
 *    probe NOC-aborts, so it is disabled below.
 *  - but `earlycon` is load-bearing (without it the kernel hangs before the
 *    ttyMSM0 driver comes up at ~2.7 s), and it can only bind via the DT
 *    stdout-path to a "qcom,msm-uartdm" node. of_setup_earlycon uses the node's
 *    reg even when the node is `disabled`, while the platform driver skips it —
 *    so keeping stdout-path = serial1 (blsp2) gives earlycon on 0x75b0000
 *    WITHOUT the driver probe crash. (earlycon on blsp1/jack faults early.)
 *  - visible output is ttyMSM0 (0x7570000, jack), which the driver brings up
 *    with clocks at ~2.7 s.
 *  Boot with cmdline: `earlycon console=ttyMSM0,115200n8` (stdout-path stays
 *  serial1, inherited from oneplus-common).
 */
/dts-v1/;

#include "msm8996pro.dtsi"
#include "msm8996-oneplus-common.dtsi"

/ {
	model = "Google Pixel XL";
	compatible = "google,marlin", "qcom,msm8996pro", "qcom,msm8996";
	chassis-type = "handset";

	/* aboot dtb-match IDs — confirmed from the aboot log (MSM8996 Pro v1.1). */
	qcom,msm-id = <422 0x10001>, <423 0x10001>;
	qcom,board-id = <0x80 0>;
};

/*
 * The whole BLSP2 block (0x75bxxxx) is dead/inaccessible on marlin — register
 * access NOC-aborts. Disable every BLSP2 peripheral oneplus-common enables.
 * (blsp2_uart2's driver is disabled, but earlycon still binds to it via
 * stdout-path — of_setup_earlycon ignores status; see the CONSOLE note above.)
 */
&blsp2_uart2 { status = "disabled"; };
&blsp2_i2c1  { status = "disabled"; };
&blsp2_i2c6  { status = "disabled"; };

/*
 * Multimedia (MMSS) and audio (LPASS) IOMMUs: register access NOC-aborts
 * because those power domains aren't up, and none are needed for a stage-1
 * serial boot. adreno_smmu (GPU) probes fine and is left enabled. VERIFIED:
 * disabling these gets the boot past all SMMUs (~2.94 s).
 */
&mdp_smmu      { status = "disabled"; };
&venus_smmu    { status = "disabled"; };
&vfe_smmu      { status = "disabled"; };
&lpass_q6_smmu { status = "disabled"; };

/*
 * GPU stack: adreno_smmu probes fine initially but NOC-aborts when re-probed
 * during deferred_probe (~13 s) as the GPU consumer pulls it in. Graphics is
 * unused for stage-1, so disable both.
 */
&gpu         { status = "disabled"; };
&adreno_smmu { status = "disabled"; };
